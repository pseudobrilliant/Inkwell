{
  "name": "inkwell",
  "version": "0.0.1",
  "description": "Practice writing daily, capture ideas and reading, and grow exercises into stories and novels.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "spec": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive && node scripts/check-spec-tests.mjs",
    "check": "npm run lint && npm run spec && npm test && npm run build",
    "deploy:test": "npm run build && scripts/deploy.sh test-vault",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@fission-ai/openspec": "^2.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "obsidian": "1.13.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
